  "bin": {
    "nodekit": "src/cli.mjs",
    "nodekit-attestation-sign": "scripts/sign-submission-attestation.mjs",
    "nodekit-attestation-verify": "scripts/verify-submission-attestation.mjs",
    "nodekit-evidence-finalize": "scripts/finalize-submission-evidence.mjs",
    "nodekit-consumer-prepare": "scripts/prepare-consumer-package.mjs",
    "nodekit-evidence-capture": "scripts/capture-managed-evidence.mjs",
    "nodekit-human-study": "scripts/capture-human-study.mjs",
    "nodekit-unpushed-work-gate": "scripts/unpushed-work-gate.mjs",
    "nodekit-reference-corpus-gate": "scripts/reference-corpus-gate.mjs"
  },
  "files": [
    "dist",
    "docs/IDEA_TO_REALITY_PRINCIPLES.md",
    "docs/WORKSPACE_REFERENCE_INDEX.md",
    "src",
    "scripts/sign-submission-attestation.mjs",
    "scripts/verify-submission-attestation.mjs",
    "scripts/finalize-submission-evidence.mjs",
    "scripts/prepare-consumer-package.mjs",
    "scripts/test-files.mjs",
    "scripts/capture-human-study.mjs",
    "scripts/unpushed-work-gate.mjs",
    "scripts/reference-corpus-gate.mjs",
    "scripts/capture-managed-evidence.mjs",
    "scripts/run-knowledge-runtime-comparison.mjs",
    "adapters",
    "schemas",
    "templates",
    "plugins",
    "evolution",
    "docs/EXECUTION_GRAPH_OF_LOOPS.md",
    "docs/GOVERNANCE_GRAPH.md",
    "ownership.yaml",
    "repositories.yaml",
    "architecture.yaml",
    "GLOSSARY.md",
    "START_HERE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node src/cli.mjs registry check --registry-root .",
    "component:codegen": "convex codegen --component-dir ./src/component",
    "build:component": "node scripts/clean-component-dist.mjs && tsc --project ./tsconfig.component.json && node scripts/copy-component-types.mjs",
    "typecheck:component": "tsc --noEmit --project ./tsconfig.component-test.json",
    "test:component": "vitest run --config ./vitest.component.config.mjs",
    "prepare": "npm run build:component",
    "audit:prod": "npm audit --omit=dev",
    "typecheck:public": "tsc -p tsconfig.public.json",
    "test:repository": "node scripts/test-files.mjs fast",
    "test": "npm run test:repository && npm run test:component",
    "presentation:nodekit-proof": "node scripts/generate-nodekit-proof-presentation.mjs",
    "acceptance:factory": "node src/factory-acceptance.mjs",
    "ease:aggregate-developer": "node scripts/aggregate-developer-timing.mjs",
    "ease:run-agent-matrix": "node scripts/run-agent-ease-matrix.mjs",
    "acceptance:agent": "node scripts/run-agent-ease-trial.mjs",
    "ease:evaluate-agents": "node scripts/evaluate-agent-ease.mjs",
    "ease:evaluate-developer": "node scripts/evaluate-ease-evidence.mjs developer",
    "ease:evaluate-humans": "node scripts/evaluate-ease-evidence.mjs humans",
    "ease:human-study": "node scripts/capture-human-study.mjs",
    "submission:prepare": "node scripts/prepare-submission.mjs",
    "submission:evaluate": "node scripts/evaluate-submission.mjs",
    "attestation:sign": "node scripts/sign-submission-attestation.mjs",
    "attestation:verify": "node scripts/verify-submission-attestation.mjs",
    "submission:finalize-evidence": "node scripts/finalize-submission-evidence.mjs",
    "consumer:prepare": "node scripts/prepare-consumer-package.mjs",
    "evidence:capture": "node scripts/capture-managed-evidence.mjs",
    "proof:package-install": "node scripts/run-package-install-proof.mjs",
    "candidate:check": "node scripts/run-local-candidate-gate.mjs --preflight",
    "candidate:prove": "node scripts/run-local-candidate-gate.mjs",
    "candidate:distribution": "node scripts/run-local-distribution-gate.mjs",
    "conformance:postgres": "node scripts/run-postgres-conformance.mjs",
    "conformance:supabase-local": "node scripts/run-supabase-local-conformance.mjs",
    "registry:check": "node src/cli.mjs registry check --registry-root .",
    "ecosystem:check": "node src/cli.mjs ecosystem check --registry-root . --workspace ..",
    "dashboard": "node src/cli.mjs dashboard --registry-root . --workspace .. --write",
    "evolution:verify": "node src/cli.mjs evolution verify --repo-root .",
    "evolution:docs": "node src/cli.mjs evolution build-docs --repo-root .",
    "reference:schemas": "node scripts/generate-reference-schema-validators.mjs",
    "reference:schemas:check": "node scripts/generate-reference-schema-validators.mjs --check",
    "knowledge:compare": "node scripts/run-knowledge-runtime-comparison.mjs",
    "check": "npm run test && npm run typecheck:public && npm run audit:prod && npm run registry:check && npm run ecosystem:check",
    "repo:map": "node src/cli.mjs repo map --write",
    "tour": "node src/cli.mjs tour",
    "copy:audit": "node src/cli.mjs copy audit",
    "behavior:index": "node src/cli.mjs behavior index --write",
    "motion:compare": "node src/cli.mjs motion compare",
    "journey:verify": "node src/cli.mjs journey verify",
    "bench:recall": "node scripts/bench-recall.mjs",
    "recall": "node scripts/recall.mjs",
    "verify:evidence": "node scripts/verify-evidence-drift.mjs",
    "test:slow": "node scripts/test-files.mjs slow",
    "test:all": "node scripts/test-files.mjs all && npm run test:component",
    "gate:trust-surface": "node scripts/ui-gates/trust-surface-selftest.mjs",
    "production-agent:check": "node src/cli.mjs production-agent check --contract production-agent.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "convex": "^1.42.3"
  },
  "peerDependenciesMeta": {
    "convex": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "24.12.2",
    "convex": "1.42.3",
    "convex-test": "0.0.54",
    "pg": "^8.22.0",
    "playwright": "1.61.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
