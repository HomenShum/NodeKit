      "default": "./src/research-collector.mjs"
    },
    "./adapters/postgres": {
      "types": "./src/adapters/postgres.d.mts",
      "import": "./src/adapters/postgres.mjs",
      "default": "./src/adapters/postgres.mjs"
    },
    "./adapters/postgres/knowledge": {
      "types": "./src/adapters/postgres-knowledge.d.mts",
      "import": "./src/adapters/postgres-knowledge.mjs",
      "default": "./src/adapters/postgres-knowledge.mjs"
    },
    "./adapters/postgres/migration.sql": "./adapters/postgres/001_caseflow.sql",
    "./adapters/postgres/knowledge-migration.sql": "./adapters/postgres/002_knowledge_runtime.sql",
    "./adapters/supabase/profile.sql": "./adapters/supabase/001_profile.sql",
    "./adapters/supabase/workers.sql": "./adapters/supabase/002_workers.sql",
