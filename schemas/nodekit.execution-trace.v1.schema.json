{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodekit.dev/schemas/nodekit.execution-trace.v1.schema.json",
  "title": "NodeTrace execution events for a compiled execution graph",
  "type": "object",
  "required": ["schemaVersion", "graphId", "graphDigest", "traceDigest", "events"],
  "properties": {
    "schemaVersion": { "const": "nodekit.execution-trace/v1" },
    "graphId": { "type": "string", "pattern": "^execution-graph:sha256:[a-f0-9]{64}$" },
    "graphDigest": { "$ref": "#/$defs/hash" },
    "traceDigest": { "$ref": "#/$defs/hash" },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "materializedEdge": {
      "type": "object",
      "required": [
        "edgeId", "fromNodeId", "toNodeId", "artifactRefs", "artifactDigests", "requiredSchema",
        "repositoryCommit", "deploymentRevision", "authority", "completeness", "limitations"
      ],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^edge:sha256:[a-f0-9]{64}$" },
        "fromNodeId": { "$ref": "#/$defs/nonEmpty" },
        "toNodeId": { "$ref": "#/$defs/nonEmpty" },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:sha256:[a-f0-9]{64}$" }
        },
        "artifactDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/hash" }
        },
        "requiredSchema": { "$ref": "#/$defs/nonEmpty" },
        "repositoryCommit": { "type": ["string", "null"], "minLength": 1 },
        "deploymentRevision": { "type": ["string", "null"], "minLength": 1 },
        "authority": { "enum": ["agent-produced", "deterministic", "human-approved", "externally-observed"] },
        "completeness": { "enum": ["complete", "partial"] },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["findingId", "lens", "severity", "behaviorId", "evidenceRefs", "result"],
      "properties": {
        "findingId": { "$ref": "#/$defs/nonEmpty" },
        "lens": { "$ref": "#/$defs/nonEmpty" },
        "severity": { "enum": ["critical", "major", "minor", "informational"] },
        "behaviorId": { "type": ["string", "null"], "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "result": { "enum": ["confirmed", "not-observed", "unsupported"] }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "sequence", "nodeId", "taskHandle", "attempt", "status", "actorClass", "actorRef",
        "startedAt", "completedAt", "findings", "handoffs"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "nodeId": { "$ref": "#/$defs/nonEmpty" },
        "taskHandle": { "type": "string", "pattern": "^task:sha256:[a-f0-9]{64}$" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "actorClass": { "enum": ["builder", "reviewer", "evaluator", "human", "runtime"] },
        "actorRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:sha256:[a-f0-9]{64}$" },
        "startedAt": { "$ref": "#/$defs/nonEmpty" },
        "completedAt": { "$ref": "#/$defs/nonEmpty" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "handoffs": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/materializedEdge" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
