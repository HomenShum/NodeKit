{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodekit.reference-chain-edge/v1",
  "title": "Immutable reference evidence chain edge",
  "description": "Binds two exact reference records to one Caseflow state, repository revision, and authority evidence. This record carries no pass, approval, verification, or stage-advance verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "edgeId",
    "from",
    "to",
    "caseBinding",
    "repositoryBinding",
    "authority",
    "createdAt",
    "limitations",
    "contentDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "nodekit.reference-chain-edge/v1" },
    "edgeId": {
      "type": "string",
      "pattern": "^reference_chain_edge_[0-9a-f]{24}$"
    },
    "from": { "$ref": "#/$defs/recordRef" },
    "to": { "$ref": "#/$defs/recordRef" },
    "caseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "stageId", "caseContentHash"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmpty" },
        "stageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "caseContentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "repositoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "commitSha", "treeHash"],
      "properties": {
        "remote": { "$ref": "#/$defs/nonEmpty" },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "treeHash": { "$ref": "#/$defs/hash" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "agent-produced",
            "deterministic",
            "externally-observed",
            "human-attested",
            "nodeproof-verified"
          ]
        },
        "attestationRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/recordRef" }
        },
        "receiptRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/recordRef" }
        }
      },
      "anyOf": [
        { "required": ["attestationRefs"] },
        { "required": ["receiptRefs"] }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "contentDigest": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "idField",
        "recordId",
        "contentDigest"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
        },
        "idField": {
          "enum": [
            "artifactId",
            "attestationId",
            "consumptionId",
            "edgeId",
            "observationId",
            "receiptId",
            "reviewContextId",
            "ruleId",
            "runId"
          ]
        },
        "recordId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "contentDigest": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
