{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodekit.reference-loop-observation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observationId",
    "source",
    "problemTags",
    "intentTags",
    "layoutTags",
    "interactionTags",
    "facts",
    "prohibitedMaterial",
    "contentDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "nodekit.reference-loop-observation/v1" },
    "observationId": { "type": "string", "pattern": "^observation_[0-9a-f]{24}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "sourceUrl",
        "sourcePolicyId",
        "firstSeenAt",
        "lastVerifiedAt",
        "accessMode"
      ],
      "properties": {
        "origin": {
          "enum": ["nodekit-owned", "workspace-private", "public-web", "mobbin"]
        },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sourcePolicyId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "firstSeenAt": { "type": "string", "format": "date-time" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "accessMode": { "enum": ["owned", "local", "public", "remote-mcp"] }
      }
    },
    "problemTags": { "$ref": "#/$defs/tags" },
    "intentTags": { "$ref": "#/$defs/tags" },
    "layoutTags": { "$ref": "#/$defs/tags" },
    "interactionTags": { "$ref": "#/$defs/tags" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factId",
          "kind",
          "subject",
          "relation",
          "object",
          "unit",
          "locatorDescription"
        ],
        "properties": {
          "factId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": {
            "enum": [
              "count",
              "measurement",
              "relationship",
              "timing",
              "easing",
              "choreography",
              "state-transition"
            ]
          },
          "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
          "relation": { "type": "string", "minLength": 1, "maxLength": 500 },
          "object": { "type": ["string", "number"] },
          "unit": { "type": "string", "minLength": 1, "maxLength": 200 },
          "locatorDescription": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "prohibitedMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storedPixels", "cachedSourcePayload", "embeddingStored"],
      "properties": {
        "storedPixels": { "const": false },
        "cachedSourcePayload": { "const": false },
        "embeddingStored": { "const": false }
      }
    },
    "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": { "origin": { "const": "mobbin" } },
            "required": ["origin"]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "sourceUrl": { "pattern": "^https://([a-z0-9-]+\\.)?mobbin\\.com/" },
              "sourcePolicyId": { "const": "atlas:mobbin/v1" },
              "accessMode": { "const": "remote-mcp" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  }
}
