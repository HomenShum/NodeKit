{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodekit.local/schemas/nodekit.execution-graph.v1.schema.json",
  "title": "Current-stage execution graph projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graphId", "caseBinding", "compiler", "nodes", "edges", "graphHash"],
  "properties": {
    "schemaVersion": { "const": "nodekit.execution-graph/v1" },
    "graphId": { "type": "string", "pattern": "^execution-graph:sha256:[a-f0-9]{64}$" },
    "caseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "stageId", "caseContentHash"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmpty" },
        "stageId": { "$ref": "#/$defs/id" },
        "caseContentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inputContentHash"],
      "properties": {
        "version": { "$ref": "#/$defs/nonEmpty" },
        "inputContentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/edge" }
    },
    "graphHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringSet": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "schemaVersion"],
      "properties": {
        "slot": { "$ref": "#/$defs/id" },
        "schemaVersion": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "kind",
        "taskRef",
        "readSet",
        "writeSet",
        "requiredEdgeIds",
        "outputSlots"
      ],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["task", "review", "barrier"] },
        "taskRef": { "$ref": "#/$defs/nonEmpty" },
        "readSet": { "$ref": "#/$defs/stringSet" },
        "writeSet": { "$ref": "#/$defs/stringSet" },
        "requiredEdgeIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "outputSlots": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slot" }
        },
        "reviewContextRef": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/id" },
        "outputSlot": { "$ref": "#/$defs/id" },
        "inputSlot": { "$ref": "#/$defs/id" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "from",
        "to",
        "requiredSchemaVersion",
        "authorityRequirement",
        "required"
      ],
      "properties": {
        "edgeId": { "$ref": "#/$defs/id" },
        "from": {
          "allOf": [
            { "$ref": "#/$defs/endpoint" },
            { "required": ["outputSlot"] }
          ]
        },
        "to": {
          "allOf": [
            { "$ref": "#/$defs/endpoint" },
            { "required": ["inputSlot"] }
          ]
        },
        "requiredSchemaVersion": { "$ref": "#/$defs/nonEmpty" },
        "authorityRequirement": {
          "enum": [
            "agent-produced",
            "deterministic",
            "human-attested",
            "nodeproof-verified"
          ]
        },
        "required": { "type": "boolean" }
      }
    }
  }
}
