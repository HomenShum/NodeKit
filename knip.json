{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/cli.mjs",
    "src/cli-main.mjs",
    "src/reference-cli.mjs",
    "src/index.mjs",
    "src/factory-acceptance.mjs",
    "src/component/convex.config.ts",
    "scripts/*.mjs",
    "test/**/*.test.mjs",
    "test/*.mjs"
  ],
  "project": ["src/**/*.{mjs,cjs,ts}", "scripts/**/*.mjs"],
  "ignore": ["src/**/_generated/**", "src/lib/reference-schema-validators.cjs"],
  "ignoreBinaries": ["convex", "docker", "psql"],
  "ignoreDependencies": ["pngjs"]
}
