{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated application coding outcome contract (local evidence only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "userJob", "target", "currentVersion", "candidateVersion", "context", "cases", "invariants", "budgets"],
  "properties": {
    "schemaVersion": { "const": "app.coding-outcome/v1" },
    "runId": { "$ref": "#/$defs/id" },
    "userJob": { "$ref": "#/$defs/text" },
    "target": { "$ref": "#/$defs/text" },
    "currentVersion": { "$ref": "#/$defs/version" },
    "candidateVersion": { "$ref": "#/$defs/version" },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["scope", "sourceRefs"],
      "properties": {
        "scope": { "$ref": "#/$defs/text" },
        "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "description", "required"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "required": { "type": "boolean" } }
      }
    },
    "invariants": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "budgets": {
      "type": "object", "additionalProperties": false, "required": ["timeMs", "costUsd", "attemptsPerCase"],
      "properties": {
        "timeMs": { "type": "integer", "minimum": 1, "maximum": 604800000 },
        "costUsd": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "attemptsPerCase": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "version": {
      "type": "object", "additionalProperties": false, "required": ["app", "generator", "environment"],
      "properties": { "app": { "$ref": "#/$defs/text" }, "generator": { "$ref": "#/$defs/text" }, "environment": { "$ref": "#/$defs/text" } }
    },
    "caseRecord": {
      "type": "object", "additionalProperties": false, "required": ["type", "caseId", "status", "summary", "evidence", "measurements"],
      "properties": {
        "type": { "const": "case" }, "caseId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["passed", "failed", "blocked"] }, "summary": { "$ref": "#/$defs/text" },
        "evidence": {
          "type": "object", "additionalProperties": false, "required": ["kind", "ref"],
          "properties": { "kind": { "enum": ["observed", "self-reported"] }, "ref": { "$ref": "#/$defs/text" } }
        },
        "measurements": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "value", "unit"],
            "properties": { "name": { "$ref": "#/$defs/id" }, "value": { "type": "number" }, "unit": { "$ref": "#/$defs/id" } }
          }
        }
      }
    },
    "decisionRecord": {
      "type": "object", "additionalProperties": false, "required": ["type", "decision", "summary"],
      "properties": { "type": { "const": "decision" }, "decision": { "enum": ["continue", "stop", "propose", "reject"] }, "summary": { "$ref": "#/$defs/text" } }
    },
    "completeRecord": {
      "type": "object", "additionalProperties": false, "required": ["type", "summary"],
      "properties": { "type": { "const": "complete" }, "summary": { "$ref": "#/$defs/text" } }
    }
  }
}
